# Android fstab file.
#<src>                  <mnt_point>         <type>    <mnt_flags and options>                               <fs_mgr_flags>
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK


/dev/block/mmcblk0p19                              	/system		ext4	ro,errors=panic,noload,block_validity                                                          wait
/dev/block/mmcblk0p9                                /boot      emmc    defaults                                                                          defaults
/dev/block/mmcblk0p10                               /recovery  emmc    defaults                                                                          defaults
/dev/block/mmcblk0p4                                /cpefs      ext4    nosuid,nodev,noatime,noauto_da_alloc,discard,journal_async_commit,errors=panic  wait,check
/dev/block/mmcblk0p20                           	/cache		ext4	noatime,nosuid,nodev,noauto_da_alloc,discard,journal_async_commit,data=ordered,errors=panic    wait,check
/dev/block/mmcblk0p21                           	/data		ext4	noatime,nosuid,nodev,noauto_da_alloc,discard,journal_async_commit,data=ordered,errors=panic    wait,check,encryptable=footer
/dev/block/mmcblk0p3                         		/efs		ext4	noatime,nosuid,nodev,noauto_da_alloc,discard,journal_async_commit,data=ordered,errors=panic    wait,check

# VOLD
/devices/13560000.dwmmc2/mmc_host/mmc*    auto    vfat    defaults    voldmanaged=sdcard1:auto,encryptable=userdata
/devices/13510000.usb/usb*                auto    auto    defaults    voldmanaged=usb:auto
/devices/13520000.usb/usb*                auto    auto    defaults    voldmanaged=usb:auto
